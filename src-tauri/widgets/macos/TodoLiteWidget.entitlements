<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 刻意保持为空：ad-hoc 签名无法为 application-groups 提供 provisioning，
	     而声明了无法兑现的 entitlement 会导致 WidgetKit 在枚举阶段丢弃扩展
	     （小组件画廊不显示）。无沙盒 + 无 entitlement 的最小形态可正常枚举，
	     数据经主应用回退路径（App Data/widget/）读取。
	     正式签名路线：恢复 com.apple.security.app-sandbox = true +
	     com.apple.security.application-groups = [group.com.syn.todolite]，
	     并用开发者身份签名（见 docs/widget-adaptation.md §4.5）。 -->
</dict>
</plist>
