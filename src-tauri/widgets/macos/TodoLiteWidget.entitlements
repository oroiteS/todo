<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 当前发布形态（个人开发签名路线）：无沙盒、无 entitlements。
	     原因：App Groups 容器的创建除签名外还需要 provisioning profile
	     （免费账号只能经 Xcode 工程自动生成，本仓库无 Xcode 工程），
	     因此扩展以「开发证书签名 + 无沙盒」形态运行，直接读主应用
	     App Data/widget/ 回退路径的快照。
	     未来接 Xcode 工程做正式分发时，恢复以下标准形态即可：
	     com.apple.security.app-sandbox = true
	     com.apple.security.application-groups = [group.com.syn.todolite]
	     （读取代码已按 容器 → 标准路径 → 回退 排序，两种形态均兼容。） -->
</dict>
</plist>
